{
  "name": "trove",
  "version": "1.4.0",
  "description": "本地优先的文档阅读器与文献库（PDF / Word / PPT / Excel / Markdown / EPUB）",
  "main": "src/main.js",
  "author": "me",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "copy-pdfjs": "node scripts/copy-pdfjs.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@iarna/rtf-to-html": "^1.1.0",
    "iconv-lite": "^0.6.3",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "mammoth": "^1.13.0",
    "marked": "^4.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "3.11.174",
    "sanitize-html": "^2.13.1",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.me.trove",
    "productName": "Trove",
    "npmRebuild": false,
    "directories": {
      "output": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/icon-source.png",
      "node_modules/pdf-lib/**/*",
      "node_modules/pdfjs-dist/package.json",
      "node_modules/pdfjs-dist/build/pdf.js",
      "node_modules/pdfjs-dist/build/pdf.worker.js",
      "node_modules/pdfjs-dist/cmaps/**/*",
      "node_modules/pdfjs-dist/standard_fonts/**/*",
      "node_modules/katex/package.json",
      "node_modules/katex/dist/katex.min.js",
      "node_modules/katex/dist/fonts/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Trove",
      "artifactName": "Trove-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Trove-${version}-portable.${ext}"
    }
  }
}
